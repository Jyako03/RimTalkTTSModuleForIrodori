<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <GameVersion Condition=" '$(GameVersion)' == '' ">1.6</GameVersion>
        <OutputType>Library</OutputType>
        <TargetFramework>net48</TargetFramework>
        <PlatformTarget>x64</PlatformTarget>
        <RootNamespace>RimTalk.TTS</RootNamespace>
        <AssemblyName>RimTalk.TTS</AssemblyName>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

        <!--
          Portable RimTalk reference resolution.
          Preferred: pass RimTalkAssemblyPath explicitly from build.ps1.
          Alternative: set RimTalkDir (or environment variable RIMTALK_DIR)
          to the RimTalk mod root, e.g. ...\Mods\3551203752.
        -->
        <RimTalkDir Condition=" '$(RimTalkDir)' == '' ">$(RIMTALK_DIR)</RimTalkDir>
        <RimTalkAssemblyPath Condition=" '$(RimTalkAssemblyPath)' == '' and '$(RimTalkDir)' != '' ">$(RimTalkDir)\1.6\Assemblies\RimTalk.dll</RimTalkAssemblyPath>

        <OutputPath>../1.6/Assemblies</OutputPath>
        <LangVersion>default</LangVersion>
    </PropertyGroup>

    <!-- Define version constants based on GameVersion -->
    <PropertyGroup>
        <DefineConstants>$(DefineConstants);V$(GameVersion.Replace('.', '_'))</DefineConstants>
    </PropertyGroup>

    <!-- Release build configuration -->
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <Optimize>false</Optimize>
        <DebugSymbols>true</DebugSymbols>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    </PropertyGroup>

    <ItemGroup>
        <!-- Core RimWorld & UnityEngine libraries -->
        <PackageReference Include="Krafs.Rimworld.Ref" Version="$(GameVersion).*-*" PrivateAssets="All" />
        <!-- Harmony API -->
        <PackageReference Include="Lib.Harmony.Ref" Version="2.*" PrivateAssets="All"/>
    </ItemGroup>

    <!-- Reference to RimTalk mod assembly for compilation (provided by game/mod at runtime) -->
    <ItemGroup>
        <Reference Include="RimTalk">
            <HintPath>$(RimTalkAssemblyPath)</HintPath>
            <!-- Do not copy the assembly into our output; the game loads mod assemblies from its folder. -->
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <Target Name="ValidateRimTalkReference" BeforeTargets="ResolveReferences">
        <Error Condition=" '$(RimTalkAssemblyPath)' == '' "
               Text="RimTalkAssemblyPath is not set. Use build.ps1 -RimTalkDir &lt;RimTalk mod root&gt;, set RIMTALK_DIR, or pass /p:RimTalkAssemblyPath=... to dotnet build." />
        <Error Condition=" '$(RimTalkAssemblyPath)' != '' and !Exists('$(RimTalkAssemblyPath)') "
               Text="RimTalk.dll was not found at '$(RimTalkAssemblyPath)'. Check -RimTalkDir / RIMTALK_DIR." />
    </Target>

</Project>
